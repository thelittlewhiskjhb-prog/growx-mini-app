# ============================================
# GROWX ENVIRONMENT VARIABLES
# Copy to .env.local and fill in your values
# ============================================

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# IMPORTANT: Never expose service_role_key in frontend
# Service-role operations must be backend-only via Edge Functions
# VITE_SUPABASE_SERVICE_ROLE_KEY=<KEEP THIS BACKEND-ONLY>

# Application Settings
VITE_APP_NAME=GROWX
VITE_APP_VERSION=1.0.0
VITE_REWARD_CYCLE_HOURS=24
VITE_TRON_NETWORK=mainnet
